# Backend (FastAPI)
APP_NAME=Data Analyst Agent
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=22432
CORS_ORIGINS=http://localhost:5173
REQUEST_ID_HEADER=X-Request-ID
AUTH_TOKEN=dev-token
DATABASE_URL=sqlite:///./data.db
SQL_ENGINE=clickhouse
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_STRICT_JSON=true
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
MIN_GROUP_SIZE=50
MAX_SCAN_BYTES=5000000000
DEFAULT_SAMPLE_RATE=1.0
ALLOW_DETAIL_EXPORT=false
RATE_LIMIT_RPS=10
DATA_PREVIEW_LIMIT=50
TASK_HISTORY_LIMIT=50

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:22432
VITE_WEB_PORT=5351
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_MB=50
